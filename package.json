{
  "name": "english-dictation-game",
  "version": "0.1.0",
  "private": true,
  "description": "Local English dictation game based on video subtitles",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron": "electron ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "wait-on": "latest"
  }
}
